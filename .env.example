# ============================================================
# MT5 Grid Bot - environment configuration
# Copy this file to ".env" and fill in your real values.
# ============================================================

# --- MT5 account / terminal credentials ---
MT5_LOGIN=12345678
MT5_PASSWORD=your_password_here
MT5_SERVER=YourBroker-Server
# Optional: full path to terminal64.exe. Leave blank to auto-detect.
MT5_PATH=

# --- Symbol ---
# Some brokers name it BTCUSD, BTCUSDm, BTCUSD.r etc. Match yours exactly.
SYMBOL=BTCUSD

# --- Grid geometry (mirrors the Pine "Master V12" engine) ---
GRID_SPACING_USD=5.00          # dist_usd: spacing AND take-profit distance
GRID_LEVELS=10                 # number of grids up AND down
# TP distance = GRID_SPACING_USD ; SL distance = GRID_SPACING_USD / SL_DIVISOR
SL_DIVISOR=2.0

# --- Anchor engine ---
# How often the grid window slides along the fixed price lattice.
# Accepts: 10S, 30S, 1M, 5M, 15M, 1H ...
ANCHOR_TIMEFRAME=10S

# --- Position sizing ---
LOT_SIZE=0.01                  # fixed lot per grid order
MAX_OPEN_POSITIONS=20          # safety cap across the whole grid
MAX_PENDING_ORDERS=0           # cap on resting pending orders (0 = no self-cap; obey broker).
                               # Set below your broker's pending-order limit to avoid retcode 10033.

# --- Order behaviour ---
MAGIC=990012                   # identifies this bot's orders
DEVIATION=20                   # max slippage in points for market fills
ORDER_COMMENT=GridV12

# --- Range detector (chop guard) ---
# Suspends ONLY levels stuck in a LOSING (sub-TP) range: price keeps crossing a
# level but reverses to its SL before reaching either take-profit. A "good" range
# that swings far enough to hit a TP is left armed. Suspended levels re-arm once
# price travels far enough (breakout / TP becomes reachable again).
RANGE_DETECT=true
RANGE_WINDOW_SEC=60            # how long price must stay boxed to evaluate a range
RANGE_BAND_MULT=1.0           # fraction of TP distance price must reach to count as a GOOD range
                              #   1.0 = must reach a full TP; lower (e.g. 0.8) = less restrictive

# --- Runtime ---
POLL_SECONDS=1.0               # main loop tick interval
DRY_RUN=true                   # true = log only, place NO real orders
CLOSE_ON_EXIT=true             # on shutdown: cancel all pendings AND close all positions
LOG_LEVEL=INFO                 # DEBUG, INFO, WARNING, ERROR
